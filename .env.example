# Alpaca paper trading credentials (required)
ALPACA_KEY_ID=your-alpaca-key-id
ALPACA_SECRET_KEY=your-alpaca-secret-key

# PostgreSQL
DB_USER=hft
DB_PASSWORD=hft

# Watched symbols for execution engine (comma-separated, no spaces)
WATCHED_SYMBOLS=AAPL,TSLA,NVDA,MSFT,AMZN

# Grafana admin password
GRAFANA_PASSWORD=admin

# JWT issuer URI (if using real OAuth2/OIDC provider, e.g. Keycloak)
# JWT_ISSUER_URI=http://localhost:8180/realms/hft
