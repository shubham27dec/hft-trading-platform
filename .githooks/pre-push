#!/bin/sh
# Runs before every push. Blocks push if tests fail or coverage drops below 70%.
# Install once per clone: git config core.hooksPath .githooks

echo "=== Pre-push: mvn verify (tests + JaCoCo coverage check) ==="
mvn verify -s settings.xml --batch-mode -q

if [ $? -ne 0 ]; then
    echo ""
    echo "PUSH BLOCKED: tests failed or coverage dropped below 70%."
    echo "Run 'mvn verify -s settings.xml' to see the details."
    exit 1
fi

echo "=== All checks passed. Pushing. ==="
exit 0
